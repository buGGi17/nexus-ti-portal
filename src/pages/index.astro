---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import AuroraShaderCanvas from '../components/AuroraShaderCanvas.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import InteractiveArchitecture from '../components/InteractiveArchitecture.astro';
import Governance from '../components/Governance.astro';
import ContactCTA from '../components/ContactCTA.astro';
---

<Layout 
  title="NEXUS TI | Consultoría Estratégica, Microservicios, BI, COBIT & ITIL"
  description="Consultoría de TI corporativa, Ingeniería de Software a Medida, Malla de Microservicios, BI y Marcos de Gobernanza (COBIT / ITIL)."
>
  <!-- Background WebGL/GLSL Aurora Boreal Shader (Ethereal ribbon reacting to scroll & mouse) -->
  <AuroraShaderCanvas />

  <Navbar />
  <main>
    <Hero />
    <ServicesGrid />
    <InteractiveArchitecture />
    <Governance />
    <ContactCTA />
  </main>
</Layout>
