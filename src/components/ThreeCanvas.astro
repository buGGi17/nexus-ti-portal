<div id="hero-canvas-container" class="absolute inset-0 w-full h-full pointer-events-none -z-10 overflow-hidden">
  <canvas id="hero-webgl-canvas" class="w-full h-full"></canvas>
</div>

<script>
  import * as THREE from 'three';

  function initHeroScene() {
    const container = document.getElementById('hero-canvas-container');
    const canvas = document.getElementById('hero-webgl-canvas') as HTMLCanvasElement;
    if (!container || !canvas) return;

    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x07090e, 0.035);

    const camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 100);
    camera.position.set(0, 0, 9);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance'
    });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // Group for mouse parallax
    const mainGroup = new THREE.Group();
    scene.add(mainGroup);

    // 1. Central Core Torus (Relay Lime Accent Theme)
    const torusGeometry = new THREE.TorusGeometry(2.3, 0.08, 16, 100);
    const torusMaterial = new THREE.MeshBasicMaterial({
      color: 0xc8ff00,
      wireframe: false,
      transparent: true,
      opacity: 0.85
    });
    const torus = new THREE.Mesh(torusGeometry, torusMaterial);
    torus.rotation.x = Math.PI / 3;
    mainGroup.add(torus);

    // Outer cyan orbital ring
    const outerTorusGeo = new THREE.TorusGeometry(3.2, 0.03, 16, 120);
    const outerTorusMat = new THREE.MeshBasicMaterial({
      color: 0x00f2fe,
      transparent: true,
      opacity: 0.45
    });
    const outerTorus = new THREE.Mesh(outerTorusGeo, outerTorusMat);
    outerTorus.rotation.y = Math.PI / 4;
    mainGroup.add(outerTorus);

    // 2. Icosahedron Tech Core
    const coreGeo = new THREE.IcosahedronGeometry(1.2, 1);
    const coreMat = new THREE.MeshStandardMaterial({
      color: 0x111827,
      wireframe: true,
      roughness: 0.2,
      metalness: 0.9,
      emissive: 0x00f2fe,
      emissiveIntensity: 0.15
    });
    const coreMesh = new THREE.Mesh(coreGeo, coreMat);
    mainGroup.add(coreMesh);

    // 3. Floating particle network (Nodes / Microservices / Data flow)
    const particleCount = 280;
    const posArray = new Float32Array(particleCount * 3);
    const colorArray = new Float32Array(particleCount * 3);

    for (let i = 0; i < particleCount * 3; i += 3) {
      posArray[i] = (Math.random() - 0.5) * 16;
      posArray[i + 1] = (Math.random() - 0.5) * 12;
      posArray[i + 2] = (Math.random() - 0.5) * 10;

      // Random color: Lime or Cyan
      const isLime = Math.random() > 0.4;
      if (isLime) {
        colorArray[i] = 0.78;     // R (c8)
        colorArray[i + 1] = 1.0;  // G (ff)
        colorArray[i + 2] = 0.0;  // B (00)
      } else {
        colorArray[i] = 0.0;      // R (00)
        colorArray[i + 1] = 0.95; // G (f2)
        colorArray[i + 2] = 1.0;  // B (fe)
      }
    }

    const particlesGeo = new THREE.BufferGeometry();
    particlesGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
    particlesGeo.setAttribute('color', new THREE.BufferAttribute(colorArray, 3));

    const particlesMat = new THREE.PointsMaterial({
      size: 0.05,
      vertexColors: true,
      transparent: true,
      opacity: 0.85
    });
    const particleSystem = new THREE.Points(particlesGeo, particlesMat);
    scene.add(particleSystem);

    // Lighting
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.9);
    scene.add(ambientLight);

    const pointLight = new THREE.PointLight(0xc8ff00, 3, 20);
    pointLight.position.set(4, 5, 4);
    scene.add(pointLight);

    const pointLight2 = new THREE.PointLight(0x00f2fe, 3, 20);
    pointLight2.position.set(-4, -5, 2);
    scene.add(pointLight2);

    // Mouse movement interaction
    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;

    const windowHalfX = window.innerWidth / 2;
    const windowHalfY = window.innerHeight / 2;

    function onMouseMove(event: MouseEvent) {
      mouseX = (event.clientX - windowHalfX) * 0.0006;
      mouseY = (event.clientY - windowHalfY) * 0.0006;
    }

    window.addEventListener('mousemove', onMouseMove, { passive: true });

    // Window resize
    function onWindowResize() {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    }
    window.addEventListener('resize', onWindowResize);

    // Render loop
    let clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      const elapsedTime = clock.getElapsedTime();

      // Smooth mouse follow
      targetX += (mouseX - targetX) * 0.05;
      targetY += (mouseY - targetY) * 0.05;

      mainGroup.rotation.y = targetX * 1.5 + elapsedTime * 0.12;
      mainGroup.rotation.x = targetY * 1.5 + Math.sin(elapsedTime * 0.5) * 0.1;

      torus.rotation.z = elapsedTime * 0.2;
      outerTorus.rotation.x = elapsedTime * 0.15;
      coreMesh.rotation.y = -elapsedTime * 0.25;

      particleSystem.rotation.y = elapsedTime * 0.03;
      particleSystem.rotation.x = -elapsedTime * 0.015;

      renderer.render(scene, camera);
    }

    animate();
  }

  // Run on mount or view transitions
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initHeroScene();
  } else {
    document.addEventListener('DOMContentLoaded', initHeroScene);
  }
</script>
