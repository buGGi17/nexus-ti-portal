---
---

<section id="soluciones" class="py-28 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 text-cyan-400 font-mono text-xs uppercase tracking-widest mb-3">
        <span class="w-1.5 h-1.5 bg-cyan-400 rounded-full animate-pulse"></span>
        Simulador de Misión Crítica
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
        Arquitectura & Telemetría en Vivo
      </h2>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        Navegá las capas tecnológicas para observar el flujo desacoplado de microservicios, analítica y gobernanza.
      </p>
    </div>

    <!-- Interactive Layer Viewer with Relay-style dark glassmorphism -->
    <div class="glass-panel-relay rounded-3xl p-6 sm:p-10 border border-white/[0.12] relative overflow-hidden shadow-2xl">
      <!-- Ambient light streak inside card -->
      <div class="absolute -top-32 left-1/3 w-80 h-80 bg-lime-400/10 rounded-full blur-[90px] pointer-events-none"></div>

      <!-- Selector tabs -->
      <div class="flex flex-wrap items-center gap-3 mb-8 border-b border-white/[0.08] pb-6" id="layer-tabs">
        <button 
          data-target="tab-mesh" 
          class="tab-btn active px-4 py-2.5 rounded-xl font-mono text-xs font-semibold bg-lime-400 text-black transition-all flex items-center gap-2"
        >
          <span class="w-2 h-2 rounded-full bg-black"></span>
          01. Malla de Microservicios & API Mesh
        </button>
        <button 
          data-target="tab-bi" 
          class="tab-btn px-4 py-2.5 rounded-xl font-mono text-xs font-semibold text-slate-300 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] transition-all flex items-center gap-2"
        >
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          02. Pipelines de Datos & Dashboards BI
        </button>
        <button 
          data-target="tab-governance" 
          class="tab-btn px-4 py-2.5 rounded-xl font-mono text-xs font-semibold text-slate-300 hover:text-white bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] transition-all flex items-center gap-2"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          03. Matriz SoD (COBIT) & Mesa ITIL
        </button>
      </div>

      <!-- Tab 1: Microservices Mesh Viewer -->
      <div id="tab-mesh" class="tab-content block">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
          <div class="lg:col-span-2 bg-[#04060a]/90 rounded-2xl p-6 border border-white/[0.08] relative">
            <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/[0.08] text-xs font-mono text-slate-400">
              <span class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                k8s-cluster.prod // istio-service-mesh
              </span>
              <span class="text-lime-400">Latencia p99: 14ms</span>
            </div>

            <!-- Visual diagram of microservices -->
            <div class="grid grid-cols-3 gap-4 py-4 text-center font-mono">
              <div class="p-4 rounded-xl bg-white/[0.02] border border-lime-400/30 flex flex-col items-center">
                <div class="w-8 h-8 rounded-lg bg-lime-400/10 text-lime-400 flex items-center justify-center font-bold text-xs mb-2">GW</div>
                <div class="text-xs text-white font-bold">API Gateway</div>
                <div class="text-[10px] text-slate-400 mt-1">mTLS + Rate Limiting</div>
              </div>
              <div class="p-4 rounded-xl bg-white/[0.02] border border-cyan-400/30 flex flex-col items-center">
                <div class="w-8 h-8 rounded-lg bg-cyan-400/10 text-cyan-400 flex items-center justify-center font-bold text-xs mb-2">SVC</div>
                <div class="text-xs text-white font-bold">Billing Engine Pod</div>
                <div class="text-[10px] text-slate-400 mt-1">Go / gRPC Distributed</div>
              </div>
              <div class="p-4 rounded-xl bg-white/[0.02] border border-lime-400/30 flex flex-col items-center">
                <div class="w-8 h-8 rounded-lg bg-lime-400/10 text-lime-400 flex items-center justify-center font-bold text-xs mb-2">MQ</div>
                <div class="text-xs text-white font-bold">Kafka Broker</div>
                <div class="text-[10px] text-slate-400 mt-1">Topic: events.trans-v1</div>
              </div>
            </div>

            <div class="mt-4 p-3 rounded-xl bg-black/80 font-mono text-[11px] text-lime-400 flex items-center justify-between border border-white/5">
              <span>$ envoy-ingress: [200 OK] 14,290 req/s auto-scaled to 12 pods</span>
              <span class="text-slate-400">Circuit Breaker: OK</span>
            </div>
          </div>

          <div class="space-y-4">
            <h4 class="text-xl font-bold text-white">Modernización & Malla Resiliente</h4>
            <p class="text-slate-300 text-sm leading-relaxed">
              Transformamos arquitecturas monolíticas en subsistemas desacoplados con contratos gRPC/REST, trazabilidad distribuida e infraestructura como código (Terraform/ArgoCD).
            </p>
            <div class="pt-2">
              <span class="inline-block px-3 py-1.5 text-xs font-mono rounded-lg bg-white/[0.05] text-lime-300 border border-white/10">
                Zero-Downtime • Canary Releases
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab 2: BI Data Pipeline Viewer -->
      <div id="tab-bi" class="tab-content hidden">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
          <div class="lg:col-span-2 bg-[#04060a]/90 rounded-2xl p-6 border border-white/[0.08] relative">
            <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/[0.08] text-xs font-mono text-slate-400">
              <span class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                analytics-pipeline // Snowflake + dbt Core
              </span>
              <span class="text-cyan-400">Freshness: &lt; 3 mins</span>
            </div>

            <!-- BI flow visualization -->
            <div class="space-y-3 font-mono text-xs">
              <div class="flex items-center justify-between p-3.5 rounded-xl bg-white/[0.02] border border-white/[0.08]">
                <span class="text-slate-300">1. Fuentes Transaccionales (Postgres, ERP SAP, APIs)</span>
                <span class="text-lime-400 font-semibold">Extracción CDC</span>
              </div>
              <div class="flex items-center justify-between p-3.5 rounded-xl bg-white/[0.02] border border-white/[0.08]">
                <span class="text-slate-300">2. Modelado dbt (Staging -> Marts Star Schema)</span>
                <span class="text-cyan-400 font-semibold">128 tests OK</span>
              </div>
              <div class="flex items-center justify-between p-3.5 rounded-xl bg-white/[0.02] border border-lime-400/40">
                <span class="text-white font-bold">3. Capa Analítica (PowerBI / Metabase / Looker)</span>
                <span class="text-lime-400 font-bold">100% Sincronizado</span>
              </div>
            </div>
          </div>

          <div class="space-y-4">
            <h4 class="text-xl font-bold text-white">Business Intelligence & Data Marts</h4>
            <p class="text-slate-300 text-sm leading-relaxed">
              Consolidamos silos de datos en almacenes gobernados y confiables. Diseñamos tableros de control con KPIs financieros, comerciales y operativos listos para la gerencia.
            </p>
            <div class="pt-2">
              <span class="inline-block px-3 py-1.5 text-xs font-mono rounded-lg bg-white/[0.05] text-cyan-300 border border-white/10">
                Data Warehousing • Modelado Dimensional
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab 3: SoD COBIT & ITIL Viewer -->
      <div id="tab-governance" class="tab-content hidden">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
          <div class="lg:col-span-2 bg-[#04060a]/90 rounded-2xl p-6 border border-white/[0.08] relative">
            <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/[0.08] text-xs font-mono text-slate-400">
              <span class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                governance-matrix // COBIT 2019 + ITIL 4 Service Desk
              </span>
              <span class="text-emerald-400">Audit Status: PASS</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono text-xs">
              <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.08]">
                <div class="text-slate-400 text-[11px] mb-1 uppercase">Segregación de Funciones (SoD)</div>
                <div class="text-white font-bold mb-2">Matriz de Incompatibilidad</div>
                <div class="text-emerald-400 text-[11px]">✔ Desarrollador ≠ Aprobador de Pase</div>
                <div class="text-emerald-400 text-[11px]">✔ Creador de Proveedor ≠ Pagador</div>
              </div>
              <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.08]">
                <div class="text-slate-400 text-[11px] mb-1 uppercase">Mesa de Servicios (ITIL)</div>
                <div class="text-white font-bold mb-2">Gestión de Incidentes & CAB</div>
                <div class="text-cyan-400 text-[11px]">✔ MTTR promedio: 18 min</div>
                <div class="text-cyan-400 text-[11px]">✔ Cumplimiento SLA: 99.8%</div>
              </div>
            </div>
          </div>

          <div class="space-y-4">
            <h4 class="text-xl font-bold text-white">Gobierno, Control & Soporte ITIL</h4>
            <p class="text-slate-300 text-sm leading-relaxed">
              Blindamos la operativa corporativa. Controles COBIT rigurosos para eliminar riesgos de fraude y mesas de servicio estructuradas para garantizar la continuidad del negocio.
            </p>
            <div class="pt-2">
              <span class="inline-block px-3 py-1.5 text-xs font-mono rounded-lg bg-white/[0.05] text-emerald-300 border border-white/10">
                Auditorías SoD • Mesa de Ayuda 24/7
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Tabs Toggle Script -->
<script>
  function setupTabs() {
    const tabs = document.querySelectorAll('.tab-btn');
    const contents = document.querySelectorAll('.tab-content');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');
        if (!target) return;

        // Reset tabs style
        tabs.forEach(t => {
          t.classList.remove('bg-lime-400', 'text-black', 'active');
          t.classList.add('bg-white/[0.04]', 'text-slate-300');
        });

        // Set active tab style
        tab.classList.add('bg-lime-400', 'text-black', 'active');
        tab.classList.remove('bg-white/[0.04]', 'text-slate-300');

        // Toggle content
        contents.forEach(content => {
          if (content.id === target) {
            content.classList.remove('hidden');
            content.classList.add('block');
          } else {
            content.classList.add('hidden');
            content.classList.remove('block');
          }
        });
      });
    });
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setupTabs();
  } else {
    document.addEventListener('DOMContentLoaded', setupTabs);
  }
</script>
