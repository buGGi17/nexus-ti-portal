<section id="hero" class="relative min-h-screen flex items-center justify-center pt-28 pb-20 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Copywriting -->
      <div class="lg:col-span-6 text-left">
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-lime-400/30 bg-lime-950/20 text-lime-400 text-xs font-mono uppercase tracking-widest mb-6 backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-lime-400 animate-pulse"></span>
          PWA Enterprise • Online & Offline Ready
        </div>

        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-[1.08] mb-6">
          The workflows run <br />
          <span class="italic font-serif text-lime-300 font-normal">themselves.</span> <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-lime-400 via-emerald-300 to-cyan-400 text-3xl sm:text-5xl font-sans">
            Consultoría TI de Misión Crítica
          </span>
        </h1>

        <p class="text-base text-slate-300 max-w-lg font-normal leading-relaxed mb-8">
          Diseñamos mallas de microservicios resilientes, pipelines de BI en tiempo real y marcos de auditoría y segregación de funciones (COBIT) con mesas de ayuda ITIL de alta disponibilidad.
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a 
            href="#servicios" 
            class="px-7 py-3 rounded-xl font-bold text-xs uppercase font-mono tracking-wider bg-lime-400 text-black hover:bg-lime-300 transition-all duration-300 shadow-[0_0_30px_rgba(200,255,0,0.35)] hover:scale-105"
          >
            Explorar Servicios
          </a>
          <a 
            href="#soluciones" 
            class="px-7 py-3 rounded-xl font-semibold text-xs uppercase font-mono tracking-wider text-slate-200 border border-white/10 hover:border-lime-400/40 bg-white/[0.03] hover:bg-white/[0.08] transition-all backdrop-blur-lg"
          >
            Ver Arquitectura 3D
          </a>
        </div>

        <div class="mt-8 flex items-center gap-6 text-xs font-mono text-slate-400">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-lime-400"></span>
            Microservicios & Cloud Native
          </div>
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            COBIT 2019 / ITIL 4
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive 3D Tilting Glass Window (Exact Relay Inspiration) -->
      <div class="lg:col-span-6 relative perspective-1000">
        <div 
          id="hero-glass-window" 
          class="glass-panel-relay rounded-2xl p-6 sm:p-7 border border-white/[0.12] transition-transform duration-200 ease-out will-change-transform relative overflow-hidden group shadow-2xl"
        >
          <!-- Stream glow reflection inside the glass -->
          <div class="absolute -top-24 -left-24 w-60 h-60 bg-lime-400/15 rounded-full blur-3xl pointer-events-none"></div>

          <!-- Glass window header bar -->
          <div class="flex items-center justify-between pb-4 mb-5 border-b border-white/[0.08] text-xs font-mono">
            <div class="flex items-center gap-2 text-slate-400">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
              <span>core.workflow.dispatch</span>
            </div>
            <span class="text-lime-400 bg-lime-400/10 px-2.5 py-0.5 rounded border border-lime-400/20 text-[11px]">
              RUNNING • 120ms
            </span>
          </div>

          <!-- Relay Interactive Flow Diagram with Glass Nodes -->
          <div class="space-y-4">
            <!-- Node 1 -->
            <div class="p-3.5 rounded-xl bg-white/[0.03] border border-white/[0.08] flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-7 h-7 rounded-lg bg-lime-400/10 text-lime-400 flex items-center justify-center font-mono text-xs font-bold">01</div>
                <div>
                  <div class="text-xs font-semibold text-white">Trigger: Solicitud de Cambio TI</div>
                  <div class="text-[10px] text-slate-400 font-mono">Portal de Incidentes Mesa de Ayuda</div>
                </div>
              </div>
              <span class="text-[10px] font-mono text-lime-300">Autenticado</span>
            </div>

            <!-- Branching connector line -->
            <div class="flex justify-center -my-1">
              <div class="w-0.5 h-6 bg-gradient-to-b from-lime-400 to-cyan-400"></div>
            </div>

            <!-- Node 2 (Condition / SoD check) -->
            <div class="p-3.5 rounded-xl bg-lime-950/20 border border-lime-400/30 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-7 h-7 rounded-lg bg-cyan-400/10 text-cyan-400 flex items-center justify-center font-mono text-xs font-bold">02</div>
                <div>
                  <div class="text-xs font-semibold text-white">Validación SoD (COBIT 2019)</div>
                  <div class="text-[10px] text-slate-400 font-mono">Conflicto de privilegios: 0 Hallazgos</div>
                </div>
              </div>
              <span class="text-[10px] font-mono text-cyan-400">Verificado</span>
            </div>

            <!-- Branching connector line -->
            <div class="flex justify-center -my-1">
              <div class="w-0.5 h-6 bg-gradient-to-b from-cyan-400 to-lime-400"></div>
            </div>

            <!-- Node 3 (Microservices deployment) -->
            <div class="p-3.5 rounded-xl bg-white/[0.03] border border-white/[0.08] flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-7 h-7 rounded-lg bg-lime-400/10 text-lime-400 flex items-center justify-center font-mono text-xs font-bold">03</div>
                <div>
                  <div class="text-xs font-semibold text-white">Despliegue a Malla de Microservicios</div>
                  <div class="text-[10px] text-slate-400 font-mono">Kubernetes Canary • Telemetría BI en vivo</div>
                </div>
              </div>
              <span class="text-[10px] font-mono text-lime-400 font-bold">Completado</span>
            </div>
          </div>

          <!-- Bottom execution details -->
          <div class="mt-5 pt-4 border-t border-white/[0.08] flex items-center justify-between text-[11px] font-mono text-slate-400">
            <span>SLA ITIL: 99.98%</span>
            <span class="text-lime-400">Mover cursor para inclinar en 3D ↗</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- 3D Tilting interaction for the Relay glass window -->
<script>
  function setupHeroTilt() {
    const windowEl = document.getElementById('hero-glass-window');
    if (!windowEl) return;

    window.addEventListener('mousemove', (e) => {
      const { innerWidth, innerHeight } = window;
      const xPercent = (e.clientX / innerWidth - 0.5) * 2; // -1 to 1
      const yPercent = (e.clientY / innerHeight - 0.5) * 2; // -1 to 1

      // Subtle dynamic tilt matching Relay
      const rotateX = -yPercent * 14;
      const rotateY = xPercent * 14;

      windowEl.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
    }, { passive: true });

    windowEl.addEventListener('mouseleave', () => {
      windowEl.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
    });
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setupHeroTilt();
  } else {
    document.addEventListener('DOMContentLoaded', setupHeroTilt);
  }
</script>
